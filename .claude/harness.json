{
  "version": 1,
  "preset": "custom",
  "project": {
    "markerFile": ".claude-plugin/marketplace.json",
    "sourceGlobs": ["plugins/**/*.mjs", "plugins/**/*.json", "plugins/**/*.tmpl", "plugins/**/commit-msg", "evals/**/*.mjs"],
    "testGlobs": ["test/**/*.test.mjs"]
  },
  "commands": {
    "safe": ["node", "claude"],
    "write": [{ "cmd": "node", "whenFlags": ["-e", "--eval", "-p", "--print"] }]
  },
  "checks": [
    { "name": "syntax", "cmd": "for f in plugins/cc-harness/bin/*.mjs plugins/cc-harness/lib/*.mjs plugins/cc-harness/lib/guards/*.mjs evals/*.mjs evals/lib/*.mjs test/*.mjs test/helpers/*.mjs; do node --check \"$f\" || exit 1; done", "fast": true },
    { "name": "validate", "cmd": "claude plugin validate plugins/cc-harness --strict", "ifExists": "plugins/cc-harness/.claude-plugin/plugin.json", "fast": true },
    { "name": "tests", "cmd": "node --test test/*.test.mjs" },
    { "name": "evals", "cmd": "node evals/run.mjs --quiet" }
  ],
  "guards": { "stop": { "checks": ["syntax", "tests", "evals"] } },
  "ci": {
    "setupSteps": [
      { "uses": "actions/setup-node@v4", "with": { "node-version": "20" } },
      { "run": "npm install -g @anthropic-ai/claude-code" }
    ],
    "extraSteps": [
      { "name": "evals via the cli", "run": "node evals/run.mjs --via cli --sample 100 --json evals/results.json" },
      { "uses": "actions/upload-artifact@v4", "if": "always()", "with": { "name": "eval-results", "path": "evals/results.json" } }
    ]
  }
}
